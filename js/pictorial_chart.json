{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Gender distribution in Olympics by Year",
  "width": 450,
  "height": 380,
  "data": {
    "url": "../data/Male_vs_Female_Percentages_by_Olympic_Year.csv",
    "format": {
      "type": "csv",
      "parse": {
        "Year": "number",
        "Male_Percent": "number",
        "Female_Percent": "number"
      }
    }
  },

  "params": [
    {
      "name": "year_filter",
      "value": 2016,
      "bind": {
        "input": "select",
        "options": [
          1896, 1900, 1904, 1908, 1912, 1920, 1924, 1928, 1932, 1936, 1948,
          1952, 1956, 1960, 1964, 1968, 1972, 1976, 1980, 1984, 1988, 1992,
          1994, 1996, 1998, 2000, 2002, 2004, 2006, 2008, 2010, 2012, 2014,
          2016, 2024
        ],
        "name": "Select Year: "
      }
    }
  ],

  "transform": [
    { "filter": "toNumber(datum.Year) == toNumber(year_filter)" },
    {
      "fold": ["Male_Percent", "Female_Percent"],
      "as": ["gender_type", "percentage"]
    },
    {
      "calculate": "datum.gender_type === 'Male_Percent' ? 'Male' : 'Female'",
      "as": "gender"
    },
    {
      "calculate": "datum.gender_type === 'Male_Percent' ? '♂' : '♀'",
      "as": "symbol"
    }
  ],

  "encoding": {
    "x": {
      "field": "gender",
      "type": "nominal",
      "axis": { "labelAngle": 0, "labelFontSize": 14, "title": null }
    },
    "y": {
      "field": "percentage",
      "type": "quantitative",
      "axis": {
        "title": "Percentage (%)",
        "titleColor": "black",
        "grid": true,
        "titleFontSize": 13,
        "titleFontWeight": "bold"
      },
      "scale": { "domain": [0, 100] }
    },
    "color": {
      "field": "gender",
      "type": "nominal",
      "scale": {
        "domain": ["Male", "Female"],
        "range": ["#0072B2", "#D55E00"]
      },
      "legend": null
    }
  },

  "layer": [
    {
      "mark": { "type": "bar", "cornerRadius": 6, "width": 110 },
      "encoding": {
        "tooltip": [
          { "field": "Year", "type": "quantitative", "title": "Year" },
          { "field": "gender", "type": "nominal", "title": "Gender" },
          {
            "field": "percentage",
            "type": "quantitative",
            "title": "Percentage",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 14,
        "fontWeight": "bold",
        "align": "center",
        "baseline": "bottom",
        "dy": -6,
        "fill": "black"
      },
      "encoding": {
        "text": {
          "field": "percentage",
          "type": "quantitative",
          "format": ".0f"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 26,
        "align": "center",
        "baseline": "bottom",
        "dy": -18,
        "fill": "black",
        "tooltip": null
      },
      "encoding": { "text": { "field": "symbol" } }
    }
  ],

  "title": {
    "expr": "'Gender Distribution, ' + year_filter + ' Olympics'",
    "anchor": "start",
    "fontSize": 16
  }
}
