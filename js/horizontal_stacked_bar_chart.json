{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Medal Distribution in 2024 Summer Paris Olympics",
  "title": {
    "text": "Medal Distribution in 2024 Summer Paris Olympics",
    "fontSize": 18,
    "fontWeight": "bold",
    "anchor": "middle",
    "color": "#2a5298"
  },
  "width": "container",
  "height": { "step": 32 },
  "autosize": { "type": "fit", "resize": true, "contains": "padding" },
  "data": {
    "url": "https://raw.githubusercontent.com/J3rey/FIT3179-Data-Visualisation-II/refs/heads/main/data/medals_by_country_2024.csv",
    "format": {
      "type": "csv",
      "parse": {
        "Total Medals": "number",
        "Gold": "number",
        "Silver": "number",
        "Bronze": "number"
      }
    }
  },
  "transform": [
    {
      "window": [{ "op": "row_number", "as": "rank" }],
      "sort": [{ "field": "Total Medals", "order": "descending" }]
    },
    {
      "filter": "datum.rank <= 15"
    },
    {
      "fold": ["Bronze", "Silver", "Gold"],
      "as": ["MedalType", "Count"]
    },
    {
      "calculate": "datum.MedalType === 'Bronze' ? 1 : datum.MedalType === 'Silver' ? 2 : 3",
      "as": "MedalOrder"
    }
  ],
  "layer": [
    {
      "mark": { "type": "bar", "tooltip": true },
      "encoding": {
        "y": {
          "field": "Country",
          "type": "nominal",
          "sort": { "field": "Total Medals", "order": "descending" },
          "axis": {
            "title": null,
            "labelFontSize": 12,
            "labelLimit": 150
          }
        },
        "x": {
          "aggregate": "sum",
          "field": "Count",
          "type": "quantitative",
          "axis": {
            "title": "Medal Count",
            "titleFontSize": 13,
            "titleFontWeight": "bold",
            "titleColor": "#2a5298",
            "labelFontSize": 11,
            "grid": true,
            "gridOpacity": 0.3
          }
        },
        "color": {
          "field": "MedalType",
          "type": "nominal",
          "scale": {
            "domain": ["Bronze", "Silver", "Gold"],
            "range": ["#cd7f32", "#c0c0c0", "#d4af37"]
          },
          "legend": {
            "title": "Medal Type",
            "orient": "top",
            "direction": "horizontal",
            "titleFontSize": 13,
            "titleFontWeight": "bold",
            "titleColor": "#2a5298",
            "labelFontSize": 12,
            "symbolSize": 150,
            "offset": 10
          }
        },
        "order": { "field": "MedalOrder", "sort": "ascending" },
        "tooltip": [
          { "field": "Country", "type": "nominal" },
          { "field": "MedalType", "type": "nominal" },
          { "field": "Count", "type": "quantitative" },
          {
            "field": "Total Medals",
            "type": "quantitative",
            "title": "Total Medals"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 4
      },
      "encoding": {
        "y": {
          "field": "Country",
          "type": "nominal",
          "sort": { "field": "Total Medals", "order": "descending" }
        },
        "x": {
          "aggregate": "sum",
          "field": "Count",
          "type": "quantitative"
        },
        "text": { "field": "Total Medals", "type": "quantitative" },
        "detail": [{ "field": "Country" }],
        "color": { "value": "#333333" }
      }
    }
  ]
}
